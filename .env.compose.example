# Optional root overrides for docker compose
# Copy to .env in the repo root if you need custom host ports

POSTGRES_PORT=5432
BACKEND_PORT=8000
REDIS_PORT=6379
KAFKA_PORT=9092
POSTGRES_DB=fleetvision
POSTGRES_USER=fleetvision
POSTGRES_PASSWORD=fleetvision
REDIS_URL=redis://redis:6379/1
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TELEMETRY_TOPIC=fleet.telemetry
OLLAMA_BASE_URL=http://host.docker.internal:11434
