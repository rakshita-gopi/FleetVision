# Used by docker-compose for the backend container.
# Copy to backend/.env.docker if needed, or edit this file directly.
# Do NOT put production secrets in git for real deployments.

SECRET_KEY=fleetvision-docker-dev-secret-change-me
DEBUG=True
DJANGO_DEBUG=True
SEED_DEMO=true

# Overridden by compose to use service name "db"
DATABASE_URL=postgres://fleetvision:fleetvision@db:5432/fleetvision

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b

# On EC2, also add: http://YOUR_PUBLIC_IP:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001

GOOGLE_CLIENT_ID=
