# Frontend (local)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Vercel production / preview:
# NEXT_PUBLIC_API_URL=/api/v1
# BACKEND_API_URL=https://YOUR-TUNNEL.trycloudflare.com/api/v1
#
# Browser → same-origin /api/v1 → Next.js proxy → BACKEND_API_URL
# Update BACKEND_API_URL whenever the Cloudflare tunnel URL changes (no client rebuild required).
